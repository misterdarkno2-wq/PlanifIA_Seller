{
  "name": "planifia-seller",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/check-public-config.js && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:ui": "node tests/ui.mjs",
    "test:billing-ui": "node tests/billing-ui.mjs",
    "test:companion-ui": "node tests/companion-ui.mjs",
    "test:edge": "npx --yes deno test --allow-env --no-config --no-lock --node-modules-dir=none supabase/functions/",
    "check:edge": "npx --yes deno check --no-config --no-lock --node-modules-dir=none supabase/functions/goal-plan/index.ts supabase/functions/billing/index.ts supabase/functions/billing-return/index.ts supabase/functions/billing-renew/index.ts",
    "test:live": "node tests/live.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0"
  },
  "devDependencies": {
    "vite": "^7.1.0",
    "@electric-sql/pglite": "^0.3.10",
    "@playwright/test": "^1.55.0"
  }
}
