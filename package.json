{
  "name": "planifia-seller",
  "version": "2.3.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/check-public-config.js && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:mobile-regressions": "node --test tests/ai-jobs.test.js tests/domain.test.js tests/mobile-*.test.js tests/mobile-*-ui.mjs",
    "test:ui": "node tests/ui.mjs",
    "test:billing-ui": "node tests/billing-ui.mjs",
    "test:companion-ui": "node tests/companion-ui.mjs",
    "test:chat-ui": "node tests/lumi-chat-ui.mjs",
    "test:update-ui": "node tests/update-ui.mjs",
    "test:legal-ui": "node tests/legal-ui.mjs",
    "test:google-ui": "node tests/google-login-ui.mjs",
    "test:recovery-ui": "node tests/recovery-ui.mjs",
    "test:csp-ui": "node tests/csp-ui.mjs",
    "test:reminders-ui": "node --test tests/reminders-ui.mjs",
    "test:edge": "npx --yes deno test --allow-env --no-config --no-lock --node-modules-dir=none supabase/functions/",
    "check:edge": "npx --yes deno check --no-config --no-lock --node-modules-dir=none supabase/functions/goal-plan/index.ts supabase/functions/play-billing/index.ts supabase/functions/play-rtdn/index.ts supabase/functions/admob-ssv/index.ts supabase/functions/lumi-chat/index.ts supabase/functions/ai-fallback/index.ts",
    "test:live": "node tests/live.mjs",
    "tauri": "node scripts/tauri.mjs",
    "desktop:dev": "npm run tauri -- dev",
    "desktop:build": "npm run tauri -- build --no-bundle",
    "android:init": "npm run tauri -- android init --ci",
    "android:apk": "npm run tauri -- android build --debug --apk --target aarch64 x86_64",
    "android:release": "npm run tauri -- android build --apk --target aarch64 armv7 x86_64",
    "android:aab": "npm run tauri -- android build --aab --target aarch64 armv7 x86_64",
    "android:dev": "npm run tauri -- android dev",
    "check:groq": "node --env-file-if-exists=supabase/functions/.env.local scripts/check-groq.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
