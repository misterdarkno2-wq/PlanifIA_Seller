# Chat local: URL HTTPS del gateway y el mismo valor privado que GATEWAY_SECRET.
AI_BASE_URL=https://TU_GATEWAY/v1
AI_API_KEY=
ALLOWED_ORIGINS=https://planifia.cl,https://www.planifia.cl,https://misterdarkno2-wq.github.io,http://localhost:5173,http://127.0.0.1:5173,https://tauri.localhost

# Respaldo en la nube cuando el PC, el túnel u Ollama no responden (funciones lumi-chat y ai-fallback).
# Proveedor: Groq (console.groq.com). Sin la clave no hay respaldo.
# Guarda GROQ_API_KEY en los secretos del proyecto Supabase; no la pegues en comandos ni chats.
# Queda comentada para que "secrets set --env-file" no la sobrescriba con un valor vacío.
# GROQ_API_KEY=
# Modelos de Groq para planes y chat, separados por comas: si Groq no ofrece uno (404/410) se usa el
# siguiente. GROQ_CHAT_MODEL vacío = la misma lista.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_CHAT_MODEL=
# json_schema (por defecto) | json_object | none, si el modelo elegido no acepta JSON Schema.
GROQ_PLAN_FORMAT=json_schema

# Pagos: integración usa exclusivamente las credenciales públicas oficiales.
TRANSBANK_ENV=integration
BILLING_SITE_URL=https://planifia.cl/
TRANSBANK_ONECLICK_ENABLED=false
BILLING_CRON_SECRET=
BILLING_CHECKOUT_TTL_MINUTES=30

# Completar únicamente al habilitar el comercio para producción.
TRANSBANK_WEBPAY_COMMERCE_CODE=
TRANSBANK_WEBPAY_API_KEY=
TRANSBANK_ONECLICK_COMMERCE_CODE=
TRANSBANK_ONECLICK_API_KEY=
TRANSBANK_ONECLICK_CHILD_CODE=

# Google Play Billing (ver docs/monetizacion.md). El JSON de la cuenta de servicio va en una sola línea.
GOOGLE_PLAY_PACKAGE_NAME=cl.planifia.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Secreto aleatorio de al menos 32 caracteres; va en la URL de push de Pub/Sub (?token=...).
PLAY_RTDN_SECRET=
# Recomendado: activa la autenticación de la suscripción push de Pub/Sub con una cuenta de servicio y
# completa ambos valores. play-rtdn exigirá además el JWT firmado por Google (ver docs/plan-incidentes.md).
# PLAY_RTDN_AUDIENCE=https://TU_PROYECTO.supabase.co/functions/v1/play-rtdn
# PLAY_RTDN_SERVICE_ACCOUNT=pubsub-push@TU_PROYECTO_GCP.iam.gserviceaccount.com
# Opcional: ID completo del bloque recompensado real (ca-app-pub-.../...). Si se define, AdMob SSV solo acredita ese bloque.
ADMOB_REWARDED_AD_UNIT=

# Secreto aleatorio (32 bytes o más) para el hash de las IP del límite por conexión de goal-plan,
# lumi-chat y ai-fallback. Si falta se usa la clave de servicio. Cárgalo aparte con secrets set.
# RATE_LIMIT_SALT=
