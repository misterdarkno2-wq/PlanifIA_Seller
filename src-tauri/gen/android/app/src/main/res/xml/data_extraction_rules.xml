<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 o superior: android:allowBackup="false" sólo apaga el respaldo en la nube; la copia
     directa entre teléfonos se excluye aquí. La cuenta se recupera iniciando sesión otra vez. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
