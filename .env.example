# Copia a .env.local. Estas variables llegan al navegador: sólo valores públicos.
# URL del proyecto y clave publishable (sb_publishable_...) o legacy anon.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# La publicación en planifia.cl usa /. Para desarrollo local, usa ./.
VITE_BASE_PATH=./
# Groq y el gateway se configuran en supabase/functions/.env.example y .env.gateway.example.
# Nunca agregues GROQ_API_KEY ni claves administrativas con prefijo VITE_.
