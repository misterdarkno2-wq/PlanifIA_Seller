# Copia este archivo a .env.gateway.local. Nunca publiques el archivo local.
# Genera un secreto aleatorio base64url de 32 bytes y guárdalo aquí.
# El mismo secreto se configura como AI_API_KEY únicamente en Supabase.
GATEWAY_SECRET=
OLLAMA_MODEL=qwen3.5:9b
GATEWAY_PORT=8012
GATEWAY_CONCURRENCY=1
GATEWAY_TIMEOUT_MS=120000
GATEWAY_MAX_TOKENS=6000
OLLAMA_NUM_CTX=8192
# -1 mantiene el modelo en VRAM sin descargarlo (evita 10-15 s de recarga por solicitud).
OLLAMA_KEEP_ALIVE=-1

# Chat "Hablar con Lumi" (ruta /v1/lumi/chat): modo rápido, nunca pasa por la cola de planes.
# Vacío = usa OLLAMA_MODEL con su mismo contexto y keep_alive (sin recargas) y salida corta; en ese
# caso, mientras se genera un plan el chat responde "Lumi está terminando un plan" y no se cobra.
# Con un modelo pequeño propio el chat no espera a los planes. Medido en este PC (RX 9060 XT 16 GB)
# junto a qwen3.5:9b: qwen3:4b-instruct usa 2,9 GB y responde en ~1 s. Usa la variante
# "instruct": qwen3:4b razona en inglés antes de responder aunque se pida think:false.
OLLAMA_CHAT_MODEL=qwen3:4b-instruct
# Sólo con un modelo propio (con el principal se usan OLLAMA_NUM_CTX y OLLAMA_KEEP_ALIVE).
CHAT_NUM_CTX=2048
CHAT_KEEP_ALIVE=30m
CHAT_MAX_TOKENS=220
CHAT_TIMEOUT_MS=30000
CHAT_CONCURRENCY=2
QUEUE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
# Clave administrativa: sólo en este PC, nunca en variables VITE_ ni en Git.
QUEUE_SERVICE_ROLE_KEY=

# El trabajador lee la cola de Supabase y usa este adaptador por loopback.
# AI_BASE_URL=https://tu-host-del-adaptador/v1
# El trabajador utiliza OLLAMA_MODEL; AI_MODEL en Supabase ya no controla los planes.
# Ollama conserva su dirección local 127.0.0.1:11434.
# Un timeout mayor aquí no amplía por sí solo el timeout de goal-plan.

# El gateway no usa Groq. Configura GROQ_API_KEY únicamente en el servidor de Supabase.
# Ver supabase/functions/.env.example y docs/respaldo-nube.md.
